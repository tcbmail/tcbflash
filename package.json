{
  "name": "tcbflash-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "generate:editorial": "node scripts/generate-editorial.mjs",
    "build": "npm run generate:editorial && vite build",
    "lint": "npm run generate:editorial && html-validate index.html story/index.html carmen/index.html vision/index.html hour/index.html press/index.html writing/index.html",
    "preview": "vite preview",
    "check:build": "node scripts/check-build.mjs",
    "build:review": "npm run build",
    "preview:review": "vite preview",
    "preview:local": "powershell -NoProfile -File scripts/preview-local.ps1"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "html-validate": "^11.9.0",
    "sharp": "^0.35.5",
    "vite": "^7.3.6"
  }
}
